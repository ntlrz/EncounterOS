{
  "renderer_mode": "gm_modern",
  "layout": {
    "grid": { "cols": 24, "rows": 24, "margin": 12, "gutter": 10 },
    "regions": {
      "right_column": { "gridRect": [16, 2, 8, 20] },
      "dialog_box":   { "gridRect": [1, 18, 14, 5] }
    }
  },
  "vars": {
    "colors": {
      "card_bg": "#16191D",
      "border_idle": "#4A5058",
      "border_active": "#D6A84B",
      "text": "#F2F0EA",
      "hp_good": "#85B89A",
      "hp_back": "#C98278",
      "dialog_bg": "#101318",
      "dialog_border": "#59616C",
      "metric_fill": "#62A88A",
      "metric_track": "#30353B",
      "condition_text": "#E9E7E1",
      "condition_bg": "#252A30",
      "condition_border": "#555D67",
      "speaker_text": "#D6A84B"
    },
    "fonts": {
      "base_family": "Segoe UI",
      "base_size": 15,
      "dialog_size": 17,
      "small_size": 10
    }
  }
}



